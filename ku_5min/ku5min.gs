/**
 * 5분 구상 발표 → 구글 스프레드시트
 *
 * 1. 구글 스프레드시트를 새로 만든다
 * 2. 확장 프로그램 → Apps Script
 * 3. 이 코드를 전부 붙여넣고 저장
 * 4. 배포 → 새 배포 → 웹 앱 (실행: 나 / 액세스: 모든 사용자)
 * 5. 나온 주소를 index.html 맨 위쪽의 SYNC 값에 넣는다
 *
 * 처음 접속하면 시트 세 개가 자동으로 생깁니다.
 *   문항   : 여기에 문제를 추가합니다. 공개 칸이 Y인 문제만 페이지에 나옵니다.
 *   명단   : 비어 있으면 누구나 들어옵니다. 이름과 코드를 적어 두면 그 사람만 들어옵니다.
 *   참여자 : 들어온 사람의 이름, 코드, 기기 표시
 *   기록   : 사람·문제마다 한 줄 (키워드, 평가, 공개, 숨김)
 *   집계   : 시트를 열 때마다 문제별 평가와 키워드를 다시 계산합니다.
 *
 * 장난 답을 지우려면 기록 시트의 숨김 칸에 Y를 적습니다. 집계와 페이지에서 빠집니다.
 *
 * 문항 시트 쓰는 법
 *   수식은 $a_1=10$ 처럼 달러 기호로 감쌉니다. 분수는 \dfrac{1}{2}
 *   칸 안에서 줄을 바꾸려면 Alt+Enter
 *   줄 앞에 > 를 쓰면 인용 칸, 줄 앞에 — 를 쓰면 오른쪽 출처 줄이 됩니다
 *   제시어 칸에는 쉼표로 단어를 나열합니다 (단어 선택형)
 *   정답은 이 시트에 적지 마세요. 시트 내용은 페이지로 그대로 전달됩니다.
 */

var Q_SHEET = '문항', L_SHEET = '명단', U_SHEET = '참여자', R_SHEET = '기록', S_SHEET = '집계';
var H_Q = ['번호','유형','공개','제시어','제시문가','제시문나','제시문다','제시문라','제시문마','문항1','문항2','문항3','문항4'];
var H_L = ['이름','코드'];
var H_U = ['이름','코드','기기','처음'];
var H_S = ['번호','유형','좋음','보통','별로','점수','참여','키워드'];
var H_R = ['이름','코드','문항','키워드','평가','공개','숨김','기기','갱신'];
var VOTE = {good: '좋음', mid: '보통', bad: '별로'};
var MAX_KW = 1, MAX_LEN = 20;
var BANK = [{"id":"1","type":"공통 개념","jm":["혈당량이 높아지면 이자에서 인슐린 분비가 늘어 혈당량을 낮추고, 혈당량이 낮아지면 글루카곤 분비가 늘어 혈당량을 높인다.","주계열성의 내부에서는 별을 수축시키려는 중력과 팽창시키려는 기체의 압력 차에 의한 힘이 서로 맞서므로, 별은 오랜 기간 일정한 크기를 유지한다.","상품 가격이 균형 가격보다 높으면 초과 공급이 생겨 가격이 내려가고, 균형 가격보다 낮으면 초과 수요가 생겨 가격이 올라간다.","수열 $\\{a_n\\}$이 $a_1=10,\\ a_{n+1}=\\dfrac{1}{2}a_n+1\\ (n\\ge 1)$을 만족시킨다."],"qs":["제시문 (가)~(다)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","문항 1에서 답한 개념의 관점에서 제시문 (라)의 수열을 설명하시오.","문항 1에서 답한 개념과 ‘임계’를 결합하여 설명할 수 있는 현상을 자연 또는 사회에서 찾고, 그 이유를 설명하시오."]},{"id":"2","type":"제시어 설명","jm":["세포막은 세포의 안과 밖을 나눈다. 산소와 같은 작은 분자는 인지질 층을 직접 통과하지만, 포도당이나 이온은 막단백질을 통해서만 이동한다.","빛이 물에서 공기로 진행할 때, 두 매질이 만나는 면에서 입사각이 임계각보다 크면 빛은 공기로 나가지 못하고 모두 반사된다.","함수 $f(x)=|x^2-1|$은 실수 전체의 집합에서 연속이다.","동영상 플랫폼은 이용 기록을 분석하여 이용자가 좋아할 만한 영상을 골라 보여 준다. 이용자는 원하는 정보를 빠르게 얻지만, 자신과 다른 생각을 접할 기회는 줄어들기도 한다."],"qs":["‘경계’라는 단어로 제시문 (가), (나)의 내용을 설명하시오.","‘경계’의 관점에서 제시문 (다)의 함수가 미분가능하지 않은 점을 찾고, 그 이유를 설명하시오.","제시문 (라)에서 떠오르는 개념을 말하고, 이를 ‘경계’와 결합하여 제시문 (라)의 사회적 문제를 설명한 뒤 해결 방안을 제시하시오."]},{"id":"3","type":"두 개념 결합","jm":["국제단위계에서 길이 1 m는 빛이 진공에서 $\\dfrac{1}{299\\,792\\,458}$초 동안 진행한 거리로 정의한다. 이에 따라 어느 나라의 측정값이든 서로 비교할 수 있다.","평균과 표준편차가 서로 다른 두 시험의 점수도 $Z=\\dfrac{X-m}{\\sigma}$로 바꾸면 하나의 잣대로 비교할 수 있다.","19세기 아일랜드는 몇몇 감자 품종에 크게 의존하고 있었는데, 감자 역병이 번지자 수확이 급감하여 대기근을 겪었다.","같은 탄소 원자로 이루어져 있어도 다이아몬드, 흑연, 풀러렌, 탄소 나노튜브는 원자의 배열이 달라 단단함과 전기 전도성이 서로 다르다."],"qs":["제시문 (가), (나)에서 공통으로 연상되는 개념을 제시하고, 그 이유를 설명하시오.","제시문 (다), (라)에서 공통으로 연상되는 개념을 제시하고, 문항 1의 개념과 대비하여 설명하시오.","문항 1의 개념과 문항 2의 개념이 결합될 때 발생할 수 있는 긍정적인 사례와 부정적인 사례를 각각 찾아 설명하시오."]},{"id":"4","type":"두 개념 전환","jm":["수소 원자의 전자는 특정한 에너지 준위만 가질 수 있으므로, 수소 기체가 방출하는 빛의 스펙트럼은 특정 파장의 선으로만 나타난다.","완두의 씨 모양은 둥근 것과 주름진 것으로 뚜렷이 구분되며, 그 중간 형태는 나타나지 않는다.","사람의 키는 여러 쌍의 대립유전자와 환경의 영향을 받으므로, 집단을 조사하면 작은 값부터 큰 값까지 끊김 없이 분포한다.","함수 $f(x)$가 닫힌구간 $[a,b]$에서 연속이고 $f(a)\\ne f(b)$이면, $f(a)$와 $f(b)$ 사이의 임의의 값 $k$에 대하여 $f(c)=k$인 $c$가 열린구간 $(a,b)$에 적어도 하나 존재한다."],"qs":["제시문 (가), (나)에서 공통으로 떠오르는 개념과 제시문 (다), (라)에서 공통으로 떠오르는 개념을 각각 말하고, 그 이유를 설명하시오.","문항 1에서 답한 두 개념을 이용하여 다음을 설명하시오.\n>‘사람의 성장은 하루하루 이어지지만, 법은 특정한 나이를 기준으로 성년과 미성년을 나눈다.’","어떤 경우에는 문항 1에서 답한 두 개념이 서로 전환되거나 결합된다. 이러한 예를 수학 또는 과학에서 찾고, 그 이유를 설명하시오."]},{"id":"5","type":"문학 연상","jm":["산에는 꽃 피네 / 꽃이 피네 / 갈 봄 여름 없이 / 꽃이 피네\n(중략)\n산에는 꽃 지네 / 꽃이 지네 / 갈 봄 여름 없이 / 꽃이 지네\n— 김소월, 「산유화」","탄소는 대기의 이산화 탄소, 생물의 유기물, 바다에 녹은 탄산 이온, 지층의 석회암과 화석 연료 등으로 형태를 바꾸며 지구 시스템의 각 권 사이를 이동한다.","수열 $\\{a_n\\}$이 $a_1=2,\\ a_{n+1}=\\dfrac{1}{1-a_n}\\ (n\\ge 1)$을 만족시킨다.","자원을 캐내어 제품을 만들고 쓰고 버리는 방식이 이어지면서 폐플라스틱과 폐배터리가 쌓이고 있다. 한편 어떤 제품은 재활용 과정에서 오히려 많은 에너지를 쓰기도 한다."],"qs":["제시문 (가)에서 연상되는 단어를 말하고, 이 단어를 활용하여 제시문 (나)를 설명하시오.","문항 1의 단어와 연관시켜 제시문 (다)의 수열을 설명하고, $a_{100}$의 값을 구하시오.","문항 1의 단어와 ‘효율’을 결합하여 제시문 (라)의 사회적 문제를 설명하고, 해결 방안을 함께 제시하시오."]},{"id":"6","type":"유사점·차이점","jm":["우라늄 235의 원자핵이 중성자를 흡수하여 분열하면 새로운 중성자가 나오고, 이 중성자가 다른 원자핵을 분열시킨다. 원자력 발전소에서는 제어봉으로 중성자의 수를 조절하여 에너지를 일정하게 얻는다.","북극의 해빙이 녹으면 태양 복사 에너지를 잘 반사하던 얼음 대신 어두운 바다가 드러난다. 바다가 에너지를 더 많이 흡수하여 수온이 오르면 해빙은 더 빠르게 녹는다.","첫째항이 양수이고 공비가 양수 $r$인 등비수열 $\\{a_n\\}$이 있다."],"qs":["제시문 (가)와 (나)에 나타난 현상의 유사점과 차이점을 설명하고, (가) 또는 (나)로 설명할 수 있는 구체적인 자연현상을 이야기해 보시오.","문항 1에서 답한 유사점과 차이점을 각각 하나의 단어로 표현하고, 두 단어의 관점에서 $r$의 값에 따른 제시문 (다)의 수열의 변화를 설명하시오.","문항 2의 두 단어를 결합하여 온라인 공간에서 허위 정보가 퍼지는 현상을 설명하고, 대응 방안을 제시하시오."]},{"id":"7","type":"단어 선택","words":"대칭, 효율, 경계, 전파, 보존","jm":[],"qs":["위에 나열된 단어 중 두 개를 선택하고, 두 단어를 활용하여 설명할 수 있는 연관 개념을 찾아 이유와 함께 설명해 보시오.","문항 1에서 찾은 개념과 같은 원리가 나타나는 예를, 문항 1에서 사용하지 않은 다른 교과(수학 또는 과학)에서 찾아 설명해 보시오.","선택하지 않은 단어 중 하나를 더하여, 문항 1의 개념을 사회현상에 적용해 설명해 보시오."]},{"id":"8","type":"공통 개념","jm":["금속에 빛을 비출 때 빛의 진동수가 문턱 진동수보다 작으면, 빛의 세기를 아무리 크게 하여도 광전자가 방출되지 않는다.","뉴런에서는 막전위가 역치에 이르지 못하면 활동 전위가 발생하지 않고, 역치에 이르면 활동 전위가 발생하여 흥분이 전도된다.","원시별이 중력으로 수축하며 중심부 온도가 약 1000만 K에 이르면 수소 핵융합 반응이 시작되어 주계열성이 된다.","어떤 감염병에서 감염자 1명은 면역이 없는 집단에서 평균 4명을 감염시킨다. 집단에서 면역을 가진 사람의 비율을 $p$라 하자. (단, $0\\le p\\le 1$)"],"qs":["제시문 (가)~(다)에서 공통으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","문항 1에서 답한 개념을 넘어섰을 때 긍정적으로 작용하는 경우와 부정적으로 작용하는 경우를 자연현상에서 찾아 각각 설명하시오.","문항 1의 개념과 ‘전파’를 결합하여 제시문 (라)의 상황을 설명하고, 감염병의 확산이 줄어들기 위한 $p$의 값의 범위를 구하시오."]},{"id":"9","type":"논리 대화","jm":["물체의 질량이 일정할 때 물체에 작용하는 알짜힘을 2배로 하면 물체의 가속도도 2배가 된다.","묽은 염산과 수산화 나트륨 수용액을 섞으면 수소 이온과 수산화 이온이 1 : 1의 몰수비로 반응하여 물이 생성된다.","흡연자는 비흡연자보다 폐암에 걸릴 확률이 높다. 그러나 모든 흡연자가 폐암에 걸리는 것은 아니며, 비흡연자 중에도 폐암 환자가 있다.","크기가 $n$인 표본을 뽑아 모평균의 신뢰도 95 %의 신뢰구간을 구하는 일을 반복하면, 구한 신뢰구간들 중 약 95 %가 모평균을 포함한다."],"qs":["제시문 (가), (나)에서 공통으로 떠오르는 개념과 제시문 (다), (라)에서 공통으로 떠오르는 개념을 각각 말하고, 대비하여 설명하시오.","아래 대화를 문항 1에서 답한 개념의 관점에서 논하시오.\n>민정: 잠을 충분히 못 잔 날에는 시험을 못 보는 경우가 많더라.\n>지훈: 이번 시험 못 봤구나. 어제 잠을 충분히 못 잤겠네.","문항 1의 두 개념이 하나의 현상 안에 결합되어 나타나는 예를 자연현상에서 찾고, 그 이유를 설명하시오."]},{"id":"10","type":"공통 개념","jm":["메테인 분자는 탄소를 중심으로 수소 4개가 정사면체의 꼭짓점 방향에 놓여 있어, 각 결합에 극성이 있어도 분자 전체는 무극성이다.","눈 결정은 물 분자가 규칙적으로 배열되면서 만들어지므로, 모양이 저마다 달라도 대부분 육각형의 틀을 가진다.","대부분의 동물은 몸의 왼쪽과 오른쪽이 거의 같은 형태를 띠어, 한 방향으로 곧게 이동하는 데 유리하다.","함수 $f(x)=x^3-3x$가 있다."],"qs":["제시문 (가)~(다)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","문항 1에서 답한 개념을 이용하여 정적분 $\\displaystyle\\int_{-2}^{2}f(x)\\,dx$의 값을 계산 없이 구하고, 그 이유를 설명하시오.","문항 1에서 답한 개념과 ‘효율’을 결합하여 설명할 수 있는 예를 자연 또는 기술에서 찾고, 그 이유를 설명하시오."]},{"id":"11","type":"공통 개념","jm":["물은 염화 수소와 반응할 때는 수소 이온을 받고, 암모니아와 반응할 때는 수소 이온을 내놓는다.","전자는 입자로 알려져 있지만, 전자 현미경에서는 파동처럼 회절하는 성질이 이용된다.","세포막의 인지질은 물과 잘 어울리는 머리 부분과 물을 밀어내는 꼬리 부분을 함께 가진다.","항생제는 많은 감염병 환자를 살려 왔다. 그러나 무분별하게 사용하면 내성 세균이 늘어나 치료가 더 어려워진다."],"qs":["제시문 (가)~(다)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","문항 1에서 답한 개념으로 제시문 (라)를 설명하시오.","문항 1에서 답한 개념과 ‘균형’을 결합하여, 제시문 (라)와 같은 문제를 다루는 기준을 제시하고 다른 사회현상에 적용하시오."]},{"id":"12","type":"두 개념 결합","jm":["밀폐된 용기 속의 얼음은 가열하면 물이 되고, 다시 냉각하면 얼음이 된다.","용수철은 탄성 한계 안에서 늘어났을 때 힘을 제거하면 원래 길이로 돌아간다.","달걀을 삶으면 단백질의 구조가 변하여, 식혀도 날달걀로 돌아가지 않는다.","뜨거운 물체와 차가운 물체를 접촉시키면 열은 뜨거운 쪽에서 차가운 쪽으로 이동하며, 저절로 반대로 이동하지는 않는다."],"qs":["제시문 (가), (나)에서 공통으로 떠오르는 개념과 제시문 (다), (라)에서 공통으로 떠오르는 개념을 각각 말하고, 대비하여 설명하시오.","함수 $f(x)=x^2$은 실수 전체의 집합에서 역함수를 갖지 않는다. 문항 1의 두 개념을 이용하여 그 이유를 설명하고, 역함수를 갖도록 만드는 방법을 제시하시오.","문항 1의 두 개념을 결합하여, 사회에서 신중하게 결정해야 할 일과 시도해 볼 수 있는 일을 나누는 기준을 사례와 함께 제시하시오."]},{"id":"13","type":"공통 개념","jm":["소리는 공기와 같은 물질의 진동을 통해 전달되므로, 진공에서는 전달되지 않는다.","뉴런의 축삭 돌기 말단에서 분비된 신경 전달 물질은 시냅스 틈을 건너 다음 뉴런에 흥분을 전달한다.","말라리아 원충은 사람에서 사람으로 직접 옮겨 가지 않고 모기를 통해 전파된다.","곡선 위의 점 $(x,y)$가 실수 $t$에 대하여 $x=2t,\\ y=t^2+1$로 나타난다."],"qs":["제시문 (가)~(다)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","문항 1에서 답한 개념의 관점에서 제시문 (라)의 $t$의 역할을 설명하고, $x$와 $y$ 사이의 관계식을 구하시오.","문항 1에서 답한 개념과 ‘신뢰’를 결합하여 화폐, 은행, 온라인 플랫폼 중 하나를 설명하고, 신뢰가 무너질 때의 문제를 제시하시오."]},{"id":"14","type":"공통 개념","jm":["마찰이 없는 궤도를 달리는 물체는 높이가 낮아지면 속력이 커지지만, 위치 에너지와 운동 에너지의 합은 일정하다.","화학 반응이 일어나면 물질의 종류는 바뀌지만, 반응 전후 원자의 종류와 수는 변하지 않는다.","합이 10인 두 양수 $x,\\ y$가 있다. 두 수의 값이 달라져도 합은 그대로이지만, 곱 $xy$는 달라진다."],"qs":["제시문 (가), (나)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","문항 1에서 답한 개념의 관점에서 제시문 (다)를 설명하고, $xy$의 최댓값을 구하시오.","에너지는 총량이 일정한데도 사람들은 에너지가 부족하다고 말한다. 문항 1에서 답한 개념과 ‘효율’을 결합하여 그 이유를 설명하고, 해결 방안을 제시하시오."]},{"id":"15","type":"두 개념 결합","jm":["물에 떨어뜨린 잉크는 저어 주지 않아도 시간이 지나면 전체로 퍼져 나간다.","폐포에서 산소는 농도가 높은 쪽에서 낮은 쪽으로 이동하여 모세 혈관으로 들어간다.","성운 속의 기체와 먼지는 중력에 의해 한곳으로 모여 원시별을 만든다.","물 분자 사이에는 수소 결합이 작용하여, 작은 물방울은 둥근 모양을 이룬다."],"qs":["제시문 (가), (나)에서 공통으로 떠오르는 개념과 제시문 (다), (라)에서 공통으로 떠오르는 개념을 각각 말하고, 대비하여 설명하시오.","평균이 같고 표준편차가 다른 두 정규분포의 곡선을 문항 1의 두 개념을 이용하여 비교하여 설명하시오.","문항 1의 두 개념을 결합하여 수도권 인구 집중 현상을 설명하고, 긍정적인 면과 부정적인 면을 각각 제시하시오."]},{"id":"16","type":"두 개념 전환","jm":["저항이 일정한 도선에서 전압을 2배로 하면 전류도 2배가 된다.","등속 직선 운동을 하는 물체의 이동 거리는 걸린 시간에 비례한다.","방사성 동위 원소의 양은 반감기가 지날 때마다 절반으로 줄어든다.","세균이 일정한 시간마다 둘로 분열하면, 세균의 수는 $1,\\ 2,\\ 4,\\ 8,\\ \\cdots$로 늘어난다."],"qs":["제시문 (가), (나)에서 공통으로 떠오르는 개념과 제시문 (다), (라)에서 공통으로 떠오르는 개념을 각각 말하고, 그 이유를 설명하시오.","함수 $y=10x$와 $y=2^x$의 값을 비교하여, $x$가 작을 때와 클 때 두 함수의 차이를 문항 1의 개념으로 설명하시오.","어떤 현상은 처음에는 문항 1의 한 개념처럼 보이다가 나중에는 다른 개념처럼 나타난다. 이러한 예를 자연 또는 사회에서 찾고, 이를 잘못 판단할 때의 위험을 설명하시오."]},{"id":"17","type":"공통 개념","jm":["버스 안에 앉은 사람에게 옆자리 승객은 정지해 있지만, 길가에 선 사람에게 그 승객은 움직이고 있다.","같은 물체의 무게는 달에서 지구의 약 $\\dfrac{1}{6}$이지만, 질량은 달라지지 않는다.","머리를 쓰다듬는 행동이 어떤 사회에서는 친근함의 표현이지만, 다른 사회에서는 무례한 행동으로 받아들여진다.","특수 상대성 이론에 따르면 시간의 흐름은 관찰자에 따라 다를 수 있지만, 진공에서 빛의 속력은 모든 관성계에서 같다."],"qs":["제시문 (가)~(다)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","제시문 (나), (라)에서 조건이 달라져도 변하지 않는 것을 찾고, 문항 1의 개념과 대비하여 설명하시오.","문항 1의 개념과 ‘보편’을 결합하여, 문화의 차이를 존중해야 하는 경우와 보편적 기준을 지켜야 하는 경우를 사례와 함께 구분하시오."]},{"id":"18","type":"두 개념 결합","jm":["콩과 식물의 뿌리혹박테리아는 식물에게 질소 화합물을 제공하고, 식물로부터 양분을 얻는다.","산호는 몸속의 조류가 광합성으로 만든 양분을 얻고, 조류는 산호 안에서 안전한 서식처를 얻는다.","먹이가 같은 두 종의 짚신벌레를 한 공간에서 기르면, 한 종은 늘어나고 다른 종은 사라지기도 한다.","같은 지역에서 같은 먹이를 먹는 두 종의 새는 먹이를 찾는 높이를 달리하며 함께 살아가기도 한다."],"qs":["제시문 (가), (나)에서 공통으로 떠오르는 개념을 말하고, 제시문 (다)에서 떠오르는 개념과 대비하여 설명하시오.","문항 1의 두 개념으로 제시문 (라)를 설명하시오.","문항 1의 두 개념이 동시에 나타나는 사회현상을 찾고, 긍정적인 사례와 부정적인 사례를 각각 설명하시오."]},{"id":"19","type":"두 개념 결합","jm":["원유를 가열하면 끓는점의 차이에 따라 여러 성분으로 나뉘어 얻어진다.","프리즘을 통과한 백색광은 파장에 따라 굴절하는 정도가 달라 여러 색으로 나뉜다.","빨강, 초록, 파랑의 빛을 함께 비추면 눈에는 흰색으로 보인다.","두 함수 $f(x)=x+1,\\ g(x)=2x$에 대하여 $f(g(x))=2x+1$이고 $g(f(x))=2x+2$이다."],"qs":["제시문 (가), (나)에서 공통으로 떠오르는 개념과 제시문 (다), (라)에서 공통으로 떠오르는 개념을 각각 말하고, 그 이유를 설명하시오.","제시문 (라)의 결과가 서로 다른 이유를 설명하고, $f(g(x))$에서 원래의 $x$를 되찾으려면 어떤 순서로 무엇을 해야 하는지 문항 1의 개념으로 설명하시오.","여러 재료를 붙인 포장재는 성능이 좋지만 재활용이 어렵다. 문항 1의 두 개념을 결합하여 그 이유를 설명하고, 해결 방안을 제시하시오."]},{"id":"20","type":"논리 대화","jm":["멘델은 완두를 여러 세대에 걸쳐 교배하고 그 결과를 세어 유전의 규칙을 찾아냈다.","다윈은 여러 지역의 생물을 관찰한 자료를 모아 자연 선택에 의한 진화를 설명하였다.","두 짝수는 $2a,\\ 2b$로 나타낼 수 있고 $2a+2b=2(a+b)$이므로, 두 짝수의 합은 항상 짝수이다.","명제 $P(n)$에 대하여 $P(1)$이 참이고, $P(k)$가 참이면 $P(k+1)$도 참임을 보이면, 모든 자연수 $n$에 대하여 $P(n)$은 참이다."],"qs":["제시문 (가), (나)에서 공통으로 떠오르는 탐구 방법과 제시문 (다)에서 떠오르는 방법을 말하고, 대비하여 설명하시오.","제시문 (라)의 방법은 이름에 ‘귀납’이 들어 있다. 이 방법이 문항 1의 두 방법 중 어디에 가까운지 판단하고 그 이유를 설명하시오.","아래 대화를 문항 1의 개념으로 논하고, 인공지능의 학습에도 같은 한계가 있는지 설명하시오.\n>수아: 우리 반 10명에게 물어보니 모두 이 앱이 좋대.\n>현우: 그럼 전국의 고등학생이 다 좋아하겠네."]},{"id":"21","type":"공통 개념","jm":["양 끝이 고정된 줄에서는 아무 진동이나 유지되지 않고, 특정한 파장의 정상파만 만들어진다.","시조는 3장 6구라는 틀을 지키면서도 시대마다 다양한 내용을 담아 왔다.","실수 $x,\\ y$가 $x\\ge0,\\ y\\ge0,\\ x+y\\le4$를 만족시킨다."],"qs":["제시문 (가), (나)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","문항 1에서 답한 개념의 관점에서 제시문 (다)를 설명하고, $x+2y$의 최댓값을 구하시오.","문항 1에서 답한 개념과 ‘자유’를 결합하여, 제약이 오히려 자유나 창의성을 높이는 사례와 지나친 제약이 문제가 되는 사례를 각각 설명하시오."]},{"id":"22","type":"문학 연상","jm":["우리는 만날 때에 떠날 것을 염려하는 것과 같이 떠날 때에 다시 만날 것을 믿습니다.\n아아 님은 갔지마는 나는 님을 보내지 아니하였습니다.\n— 한용운, 「님의 침묵」","거북이보다 뒤에서 출발한 사람은 거북이가 있던 지점에 도착해도 거북이가 조금 앞서 있으므로 영원히 따라잡지 못한다는 주장이 있다. 그러나 실제로는 따라잡는다.","엔진의 연료 효율이 좋아져 비용이 줄면 사람들이 차를 더 많이 타서, 전체 연료 소비량이 오히려 늘어나기도 한다."],"qs":["제시문 (가)의 표현 방식에서 연상되는 단어를 말하고, 그 이유를 설명하시오.","문항 1의 단어로 제시문 (나)를 설명하고, 등비급수 $1+\\dfrac{1}{2}+\\dfrac{1}{4}+\\cdots$의 합을 이용하여 이 주장의 문제점을 밝히시오.","문항 1의 단어와 ‘효율’을 결합하여 제시문 (다)를 설명하고, 이러한 현상을 막기 위한 방안을 제시하시오."]},{"id":"23","type":"문학 연상","jm":["지금 눈 내리고 / 매화 향기 홀로 아득하니 / 내 여기 가난한 노래의 씨를 뿌려라\n다시 천고의 뒤에 / 백마 타고 오는 초인이 있어 / 이 광야에서 목놓아 부르게 하리라\n— 이육사, 「광야」","고생대의 식물이 땅속에 묻힌 뒤 오랜 시간 열과 압력을 받아 석탄이 만들어졌다.","처음 금액 $a$를 연이율 10 %의 복리로 맡기면, $n$년 후의 금액은 $a(1.1)^n$이 된다."],"qs":["제시문 (가)에서 연상되는 단어를 말하고, 이 단어를 활용하여 제시문 (나)를 설명하시오.","문항 1의 단어와 연관시켜 제시문 (다)를 설명하고, 처음의 작은 차이가 시간이 지나면 어떻게 달라지는지 말하시오.","문항 1의 단어와 ‘임계’를 결합하여, 기초 과학 연구나 교육처럼 성과가 늦게 나타나는 분야에 왜 꾸준한 투자가 필요한지 설명하시오."]},{"id":"24","type":"공통 개념","jm":["멀리 있는 별빛의 스펙트럼에서도 지구의 원소와 같은 위치의 선이 나타난다.","박테리아부터 사람까지 거의 모든 생물은 같은 유전 암호를 사용한다.","$(a+b)^2=a^2+2ab+b^2$은 $a,\\ b$에 어떤 실수를 넣어도 성립한다.","세계 인권 선언은 모든 사람이 태어날 때부터 자유롭고 존엄하며 평등하다고 밝힌다."],"qs":["제시문 (가)~(라)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","제시문 (다)의 식과 방정식 $x^2-1=0$의 차이를 문항 1의 개념으로 설명하시오.","문항 1의 개념과 ‘다양성’을 결합하여, 온실가스 감축처럼 모든 나라가 참여해야 하는 문제에서 나라마다 다른 사정을 어떻게 고려할지 설명하시오."]},{"id":"25","type":"공통 개념","jm":["마이크는 소리의 진동을 전기 신호로 바꾸고, 스피커는 전기 신호를 다시 소리로 바꾼다.","망막의 시각 세포는 빛 자극을 받아 전기 신호를 만들어 뇌로 보낸다.","DNA의 유전 정보는 mRNA로 전사되고, 다시 아미노산 서열로 번역되어 단백질이 만들어진다.","양수 $a,\\ b$에 대하여 $\\log_{10}ab=\\log_{10}a+\\log_{10}b$이다."],"qs":["제시문 (가)~(다)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","문항 1의 개념으로 제시문 (라)를 설명하고, 로그를 사용하면 어떤 점이 편리한지 말하시오.","문항 1의 개념과 ‘손실’을 결합하여 번역, 요약, 사진 압축 중 하나를 설명하고, 어디까지 손실을 허용할 수 있는지 판단 기준을 제시하시오."]},{"id":"26","type":"공통 개념","jm":["원자는 최외각 전자가 부족할 때 다른 원자와 전자를 공유하여 안정한 전자 배치를 이룬다.","제1형 당뇨병 환자는 인슐린이 부족하므로 외부에서 인슐린을 주사한다.","물이 부족한 지역에서는 바닷물의 염분을 제거하여 마실 물을 얻기도 한다.","동전 3개를 던질 때 ‘적어도 1개는 앞면이 나올 확률’은 ‘모두 뒷면이 나올 확률’을 이용하여 구할 수 있다."],"qs":["제시문 (가)~(다)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","문항 1의 개념과 연관시켜 제시문 (라)의 확률을 구하고, 왜 이런 방법을 쓰는지 설명하시오.","문항 1의 개념과 ‘대체’를 결합하여 농촌의 일손 부족을 기계로 메우는 일을 설명하고, 대체할 수 있는 것과 없는 것을 구분하시오."]},{"id":"27","type":"제시어 설명","jm":["소음 제거 헤드폰은 주변 소음과 위상이 반대인 소리를 만들어 소음을 줄인다.","비눗방울의 얇은 막에서는 위아래 면에서 반사된 빛이 겹쳐 특정 색이 강하게 보인다.","교감 신경과 부교감 신경은 같은 기관에 반대로 작용하여 심장 박동을 조절한다.","함수 $y=\\sin x$와 $y=\\sin(x+\\pi)$가 있다."],"qs":["‘보강’과 ‘상쇄’라는 단어로 제시문 (가)~(다)의 내용을 설명하시오.","제시문 (라)의 두 함수의 합을 구하고, 그 결과를 문항 1의 단어로 설명하시오. 또한 $y=\\sin x+\\sin x$와 비교하시오.","문항 1의 단어와 ‘임계’를 결합하여 설명할 수 있는 현상을 자연 또는 사회에서 찾고, 그 이유를 설명하시오."]},{"id":"28","type":"공통 개념","jm":["달리던 버스가 갑자기 멈추면 승객의 몸은 앞으로 쏠린다.","코일에 자석을 가까이 하면, 자기 선속의 변화를 방해하는 방향으로 유도 전류가 흐른다.","혈액은 산성 물질이 조금 들어와도 pH가 크게 변하지 않는다.","필름 카메라로 큰 성공을 거둔 기업이 디지털 기술을 먼저 개발하고도 기존 사업을 고수하다가 시장을 잃었다."],"qs":["제시문 (가)~(다)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","시각 $t$에서 물체의 위치가 $x=3t+2$일 때와 $x=t^2$일 때를 비교하여, 문항 1의 개념을 속도와 가속도로 설명하시오.","문항 1의 개념과 ‘혁신’을 결합하여 제시문 (라)를 설명하고, 사회나 조직이 변화에 대응하는 방안을 제시하시오."]},{"id":"29","type":"공통 개념","jm":["세포는 크기가 커질수록 부피에 비해 표면적이 작아져 물질 교환이 어려워지므로, 일정한 크기가 되면 분열한다.","사막여우는 몸에 비해 귀가 커서 열을 잘 내보내고, 북극여우는 귀가 작아 열 손실이 적다.","정육면체의 한 모서리의 길이가 $k$배가 되면, 겉넓이는 $k^2$배, 부피는 $k^3$배가 된다."],"qs":["제시문 (가), (나)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","문항 1의 개념으로 제시문 (다)를 설명하고, 부피에 대한 겉넓이의 비가 $k$에 따라 어떻게 달라지는지 말하시오.","문항 1의 개념과 ‘효율’을 결합하여, 크기가 커질수록 유리한 사회 시스템과 불리해지는 사회 시스템을 각각 찾아 설명하시오."]},{"id":"30","type":"논리 대화","jm":["18족 원소는 전자 배치가 안정하여 다른 원소와 거의 반응하지 않는다.","두 손전등의 빛은 서로 교차한 뒤에도 각자의 경로로 그대로 나아간다.","두 사건 $A,\\ B$에 대하여 $P(A\\cap B)=P(A)P(B)$이면, $A$와 $B$는 서로 독립이다."],"qs":["제시문 (가)~(다)를 읽고 공통적으로 떠오르는 개념을 말하고, 그 이유를 설명하시오.","아래 대화를 문항 1의 개념으로 논하시오.\n>지호: 동전이 다섯 번 연속 앞면이 나왔어.\n>유나: 그러면 이번에는 뒷면이 나올 확률이 더 높겠네.","문항 1의 개념과 ‘연결’을 결합하여, 온라인으로 연결되어 있어도 외로움을 느끼는 현상을 설명하고 해결 방안을 제시하시오."]}];


function doGet() { return json({ok: true, app: 'ku5min'}); }

function doPost(e) {
  try {
    var d = JSON.parse(e.postData.contents);
    if (d.action === 'save') return json(save(d));
    return json(init(d));
  } catch (err) {
    return json({error: String(err)});
  }
}


/** 접속: 문제 + 전체 집계 + 내 기록을 돌려준다 */
function init(d) {
  ready();
  var who = null;
  if (clean(d.name)) {
    who = user(clean(d.name), clean(d.code), clean(d.dev));
    if (who.error) return who;
  }
  var rs = records();
  return {ok: true, problems: problems(), stats: stats(rs), me: who ? mine(rs, who) : {}};
}


/** 키워드·평가·공개 여부 저장. 사람·문제마다 한 줄을 고쳐 쓴다 */
function save(d) {
  var who = user(clean(d.name), clean(d.code), clean(d.dev));
  if (who.error) return who;
  var id = clean(d.id);
  if (!id) return {error: 'id'};
  return locked(function () {
    var sh = sheet(R_SHEET, H_R);
    var at = findRow(sh, who, id);
    var row = at ? sh.getRange(at, 1, 1, H_R.length).getValues()[0] : [who.name, who.code, id, '', '', '', '', '', ''];
    if (d.kw !== undefined) row[3] = words(d.kw).join(', ');
    if (d.vote !== undefined) row[4] = VOTE[d.vote] || '';
    if (d.pub !== undefined) row[5] = d.pub ? 'Y' : '';
    row[7] = clean(d.dev);
    row[8] = new Date();
    if (!at) at = sh.getLastRow() + 1;
    sh.getRange(at, 1, 1, H_R.length).setValues([row]);
    return {ok: true, stat: stats(records())[id] || emptyStat()};
  });
}


function problems() {
  var sh = sheet(Q_SHEET, H_Q);
  if (sh.getLastRow() < 2) return [];
  var v = sh.getRange(1, 1, sh.getLastRow(), sh.getLastColumn()).getValues();
  var h = v[0], col = {};
  for (var i = 0; i < h.length; i++) col[String(h[i]).trim()] = i;
  var out = [];
  for (var r = 1; r < v.length; r++) {
    var c = function (n) { return col[n] === undefined ? '' : String(v[r][col[n]]).trim(); };
    if (!c('번호') || c('공개').toUpperCase() !== 'Y') continue;
    var jm = ['제시문가','제시문나','제시문다','제시문라','제시문마'].map(c).filter(String);
    var qs = ['문항1','문항2','문항3','문항4'].map(c).filter(String);
    out.push({id: c('번호'), type: c('유형'), words: c('제시어'), jm: jm, qs: qs});
  }
  return out;
}

function records() {
  var sh = sheet(R_SHEET, H_R);
  if (sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, H_R.length).getValues().map(function (r) {
    var v = '';
    Object.keys(VOTE).forEach(function (k) { if (VOTE[k] === r[4]) v = k; });
    return {name: String(r[0]), code: String(r[1]), id: String(r[2]), kw: String(r[3]), vote: v, pub: r[5] === 'Y', hide: r[6] === 'Y'};
  });
}

function emptyStat() { return {good: 0, mid: 0, bad: 0, n: 0, kw: []}; }

/** 문제별 좋아요·별로 수와 키워드 빈도 */
function stats(rs) {
  var out = {};
  rs.forEach(function (r) {
    if (r.hide) return;
    var s = out[r.id] || (out[r.id] = {good: 0, mid: 0, bad: 0, n: 0, map: {}});
    if (r.vote) s[r.vote]++;
    var ws = words(r.kw);
    if (ws.length) s.n++;
    ws.forEach(function (w) {
      var k = norm(w);
      var e = s.map[k] || (s.map[k] = {w: w, c: 0, who: []});
      e.c++;
      if (r.pub) e.who.push(r.name);
    });
  });
  Object.keys(out).forEach(function (id) {
    var s = out[id];
    s.kw = Object.keys(s.map).map(function (k) { return s.map[k]; }).sort(function (a, b) { return b.c - a.c; });
    delete s.map;
  });
  return out;
}

function mine(rs, who) {
  var out = {};
  rs.forEach(function (r) {
    if (r.name === who.name && r.code === who.code) out[r.id] = {kw: words(r.kw), vote: r.vote, pub: r.pub};
  });
  return out;
}

/** 명단이 있으면 명단으로 확인하고, 없으면 처음 쓰는 이름을 등록한다 */
function user(name, code, dev) {
  if (!name || !code) return {error: 'name'};
  var list = roster();
  if (list.length) {
    var hit = list.filter(function (x) { return x.name === name; })[0];
    if (!hit) return {error: 'list'};
    if (hit.code !== code) return {error: 'code'};
  }
  var sh = sheet(U_SHEET, H_U);
  var at = findUser(sh, name);
  if (at) {
    if (!list.length && String(sh.getRange(at, 2).getValue()) !== code) return {error: 'code'};
    return {name: name, code: code};
  }
  return locked(function () {
    var again = findUser(sh, name);
    if (again) return list.length || String(sh.getRange(again, 2).getValue()) === code ? {name: name, code: code} : {error: 'code'};
    var row = sh.getLastRow() + 1;
    sh.getRange(row, 1, 1, H_U.length).setValues([[name, code, dev || '', new Date()]]);
    return {name: name, code: code};
  });
}

function roster() {
  var sh = sheet(L_SHEET, H_L);
  if (sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, 2).getValues()
    .filter(function (r) { return String(r[0]).trim(); })
    .map(function (r) { return {name: String(r[0]).trim(), code: String(r[1]).trim()}; });
}

function findUser(sh, name) {
  var last = sh.getLastRow();
  if (last < 2) return 0;
  var v = sh.getRange(2, 1, last - 1, 1).getValues();
  for (var i = 0; i < v.length; i++) if (String(v[i][0]) === name) return i + 2;
  return 0;
}

function findRow(sh, who, id) {
  var last = sh.getLastRow();
  if (last < 2) return 0;
  var v = sh.getRange(2, 1, last - 1, 3).getValues();
  for (var i = 0; i < v.length; i++) {
    if (String(v[i][0]) === who.name && String(v[i][1]) === who.code && String(v[i][2]) === id) return i + 2;
  }
  return 0;
}

/** 쉼표로 나누고, 같은 단어를 지우고, 개수를 제한한다 */
function words(x) {
  var list = Array.isArray(x) ? x : String(x || '').split(',');
  var seen = {}, out = [];
  list.forEach(function (w) {
    w = clean(w).slice(0, MAX_LEN);
    var k = norm(w);
    if (k && !seen[k] && out.length < MAX_KW) { seen[k] = 1; out.push(w); }
  });
  return out;
}

function norm(w) { return String(w).replace(/\s+/g, '').toLowerCase(); }

/** 공백을 다듬고, 시트가 수식으로 읽을 앞글자를 뗀다 */
function clean(s) { return String(s === undefined || s === null ? '' : s).trim().replace(/^[=+\-@]+/, '').slice(0, 40); }

function locked(fn) {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try { return fn(); } finally { lock.releaseLock(); }
}

function ready() {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(Q_SHEET);
  if (sh) return;
  locked(function () {
    var q = sheet(Q_SHEET, H_Q);
    if (q.getLastRow() > 1) return;
    var rows = BANK.map(function (p) {
      var j = p.jm.concat(['','','','','']).slice(0, 5), s = p.qs.concat(['','','','']).slice(0, 4);
      return [p.id, p.type, 'Y', p.words || ''].concat(j, s);
    });
    q.getRange(1, 1, q.getMaxRows(), 1).setNumberFormat('@');
    q.getRange(2, 1, rows.length, H_Q.length).setValues(rows);
    [[L_SHEET, H_L], [U_SHEET, H_U]].forEach(function (x) {
      sheet(x[0], x[1]).getRange(1, 2, 1000, 1).setNumberFormat('@');
    });
    sheet(R_SHEET, H_R).getRange(1, 2, 1000, 1).setNumberFormat('@');
  });
}

/** 시트를 열 때 집계를 다시 계산한다 */
function onOpen() {
  ready();
  SpreadsheetApp.getUi().createMenu('5분 구상').addItem('집계 새로고침', 'refresh').addToUi();
  refresh();
}

function refresh() {
  var q = sheet(Q_SHEET, H_Q), sh = sheet(S_SHEET, H_S), st = stats(records());
  if (sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, H_S.length).clearContent();
  if (q.getLastRow() < 2) return;
  var rows = q.getRange(2, 1, q.getLastRow() - 1, 2).getValues().filter(function (r) { return String(r[0]).trim(); }).map(function (r) {
    var s = st[String(r[0]).trim()] || emptyStat();
    var top = s.kw.slice(0, 5).map(function (k) { return k.w + ' ' + k.c; }).join(', ');
    return [String(r[0]), r[1], s.good, s.mid, s.bad, s.good - s.bad, s.good + s.mid + s.bad, top];
  });
  if (rows.length) sh.getRange(2, 1, rows.length, H_S.length).setValues(rows);
}

function sheet(name, head) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    sh.appendRow(head);
    sh.getRange(1, 1, 1, head.length).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

function json(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}
